# Copier ce fichier en .env et remplir les valeurs. Le .env n'est jamais commité.

# Django
SECRET_KEY=change-me
DEBUG=True

# Telegram — rappels d'entretien
# 1. Créer un bot avec @BotFather sur Telegram, il donne le token.
# 2. Ouvrir le bot dans Telegram et cliquer « Démarrer » : un bot ne peut écrire
#    qu'à quelqu'un qui lui a déjà parlé.
# 3. Trouver l'identifiant de la conversation : ouvrir dans un navigateur
#    https://api.telegram.org/bot<TOKEN>/getUpdates et lire "chat": {"id": ...}
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789
